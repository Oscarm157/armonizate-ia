# Copia a .env.local y rellena. NUNCA comitees .env.local.
# Postgres (Neon u otro). Driver: @neondatabase/serverless.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Secreto para firmar sesiones. Mínimo 16 chars. Genera uno:
#   openssl rand -base64 32
AUTH_SECRET=

# Almacenamiento de las fotos (Vercel Blob). Sin esto no se puede guardar nada.
BLOB_READ_WRITE_TOKEN=

# Modelo de imagen. Sin esta llave el portal levanta pero no genera simulaciones.
REPLICATE_API_TOKEN=

# Correo (opcional).
RESEND_API_KEY=
EMAIL_FROM=

# Claves compartidas de acceso (mínimo 8 caracteres). La de ejecutivo abre el simulador
# y el historial; la de administración, además, ejecutivos, reporte y validación.
ACCESO_EJECUTIVO=
ACCESO_ADMIN=
