# Copia a .env.local y rellena. NUNCA comitees .env.local.
# Postgres (Neon u otro). Driver: @neondatabase/serverless.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Secreto para firmar sesiones. Mínimo 16 chars. Genera uno:
#   openssl rand -base64 32
AUTH_SECRET=

# Almacenamiento de las fotos (Vercel Blob). Sin esto no se puede guardar nada.
BLOB_READ_WRITE_TOKEN=

# Modelo de imagen. Sin esta llave el portal levanta pero no genera simulaciones.
REPLICATE_API_TOKEN=

# Correo (opcional).
RESEND_API_KEY=
EMAIL_FROM=

# Seed del admin inicial (npm run db:seed). Si vacíos, usa admin@example.com + password random.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Sentry (errores en prod). Sin DSN, Sentry queda inerte (no rompe nada).
NEXT_PUBLIC_SENTRY_DSN=
